# enDetalle: sitio (frontend). Se sube junto con index.html y la carpeta assets.
# Hace cuatro cosas: un solo nombre para el sitio, siempre HTTPS, que las rutas de la app (/detalle/..., /planes, etc.)
# carguen index.html, y cabeceras de seguridad básicas.

Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Un solo nombre: www.midominio.com.ar redirige a midominio.com.ar
    # (las cookies de sesión y los permisos de la API están pensados para ese nombre)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Siempre por HTTPS (se deja pasar /.well-known para la renovación automática del certificado)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Si no es un archivo ni una carpeta real, la ruta la resuelve la aplicación (React Router)
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# Nunca se sirven archivos ocultos ni copias olvidadas
<IfModule mod_authz_core.c>
    <FilesMatch "^\.(?!well-known)">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(env|sql|log|bak|old|orig|swp|ini|sh|lock|map)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Cabeceras de seguridad básicas (no se usa Content-Security-Policy: un error ahí rompería el sitio, se puede sumar después)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"

    # index.html siempre se vuelve a pedir: así una versión nueva se ve enseguida
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Comprimir texto para que cargue más rápido
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
