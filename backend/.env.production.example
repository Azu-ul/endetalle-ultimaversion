# =============================================================================
# enDetalle - configuracion de PRODUCCION (hosting compartido cPanel, PHP 8.3)
# =============================================================================
# Como usarlo:
#   1. Copiar este archivo como ".env" dentro de la carpeta del backend en el servidor
#      (Administrador de archivos de cPanel -> backend -> Copiar/Renombrar -> ".env").
#   2. Reemplazar TODOS los valores de ejemplo (midominio.com.ar, claves, contrasenas).
#   3. NUNCA subir el .env a GitHub ni mandarlo por mail o chat: tiene las claves del sitio.
#
# Dos dominios separados, pero del MISMO dominio principal (para que las cookies de sesion funcionen):
#   - Sitio (frontend):  https://midominio.com.ar
#   - API (backend):     https://api.midominio.com.ar
# Usar un solo nombre para el sitio (con o sin www) y redirigir el otro: aca se escribe el elegido.
# Los valores con espacios o simbolos van entre comillas dobles.

# ---------- Aplicacion ----------
APP_NAME="enDetalle"
APP_ENV=production
# Clave de cifrado. Se genera UNA vez y no se cambia nunca (si se cambia se cierran todas las sesiones).
# La imprime deploy/build.ps1 al terminar, o se genera con: php artisan key:generate --show
APP_KEY=
# SIEMPRE false en produccion: con true se mostrarian errores con rutas del servidor y datos internos.
APP_DEBUG=false
# URL publica de la API (con https, sin barra al final). Con esta direccion se arman los links de los emails
# de verificacion y las direcciones de los webhooks de pago.
APP_URL=https://api.midominio.com.ar
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------- Frontend, CORS y sesion ----------
# URL publica del SITIO (con https, sin barra al final). Es el UNICO origen que la API deja usar desde un
# navegador (CORS), y a donde llevan los links de los emails (verificar email, recuperar contrasena) y el
# regreso de Mercado Pago y PayPal.
FRONTEND_URL=https://midominio.com.ar
# Host del sitio SIN https:// (Sanctum acepta sesiones solo desde aca).
SANCTUM_STATEFUL_DOMAINS=midominio.com.ar
# La API no sirve el sitio (esta en otro dominio): dejar vacio.
SPA_INDEX=
# Las cookies de sesion se comparten entre el sitio y la API: va el dominio principal CON un punto adelante.
SESSION_DOMAIN=.midominio.com.ar
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# ---------- Base de datos MySQL (se crea en cPanel -> Bases de datos MySQL) ----------
# En cPanel el nombre de la base y del usuario llevan un prefijo: "usuariocpanel_endetalle".
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usuariocpanel_endetalle
DB_USERNAME=usuariocpanel_endetalle
DB_PASSWORD=

# ---------- Correo SMTP (casilla creada en cPanel -> Cuentas de correo) ----------
# Se usa para: verificar el email al registrarse, recuperar contrasena, comprobantes de pago, avisos de
# vencimiento, reembolsos y el formulario de contacto.
# Servidor: mail.midominio.com.ar. Puerto 465 con MAIL_SCHEME=smtps (recomendado).
# Si el hosting indica el puerto 587, usar MAIL_PORT=587 y dejar MAIL_SCHEME vacio.
MAIL_MAILER=smtp
MAIL_HOST=mail.midominio.com.ar
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-responder@midominio.com.ar
MAIL_PASSWORD=
# Tiene que ser EXACTAMENTE la casilla de MAIL_USERNAME (si no, los mails caen en spam).
MAIL_FROM_ADDRESS=no-responder@midominio.com.ar
MAIL_FROM_NAME="${APP_NAME}"
# Donde llegan los mensajes del formulario de contacto y los avisos de reembolso (puede ser cualquier casilla).
CONTACT_EMAIL=

# ---------- Pagos: credenciales de PRODUCCION (no las de prueba) ----------
# Mercado Pago (pesos): panel de desarrolladores -> Tus integraciones -> Credenciales de produccion.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de los webhooks (Tus integraciones -> Webhooks -> Clave secreta).
MERCADOPAGO_WEBHOOK_SECRET=
# PayPal (dolares): developer.paypal.com -> Apps -> App en modo LIVE.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# ID del webhook de PayPal (se crea con la URL https://api.midominio.com.ar/api/webhooks/paypal).
PAYPAL_WEBHOOK_ID=

# ---------- Reembolsos ----------
REFUND_WINDOW_DAYS=15
REFUND_PERCENT=100

# ---------- Archivos de los detalles (DWG y SKP) ----------
# Siempre en un disco PRIVADO (storage/app/private); salen solo por la ruta autenticada de la API.
DETAILS_DISK=local
# Tope por archivo en MB. Tiene que ser MENOR que el limite de subida del hosting (16 MB por defecto).
DETAILS_MAX_MB=15
FILESYSTEM_DISK=local

# ---------- Logs: un archivo por dia, se guardan 14 dias y despues se borran solos ----------
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
# En produccion solo avisos y errores (con debug se llenaria el disco).
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ---------- Cache, colas y otros (sin servicios extra: no hay Redis ni workers en el hosting) ----------
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ---------- Administrador del sitio ----------
# SOLO se usan al correr el seeder que crea al administrador (php artisan db:seed --class=ProductionSeeder).
# La contrasena tiene que tener al menos 12 caracteres. DESPUES de crearlo se pueden BORRAR estas tres lineas
# del .env (la contrasena queda guardada cifrada en la base y se cambia desde Mi cuenta).
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# NOTA: Laravel trae otras variables (Redis, AWS, Slack, Memcached, etc.) que este sitio NO usa. No hace falta agregarlas.
